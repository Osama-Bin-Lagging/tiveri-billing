---
config:
  theme: base
  themeVariables:
    fontFamily: Arial
    fontSize: 18px
    primaryColor: "#DDF7F3"
    primaryBorderColor: "#078E9B"
    primaryTextColor: "#173C55"
    lineColor: "#16869B"
  flowchart:
    curve: linear
    nodeSpacing: 24
    rankSpacing: 32
---
flowchart LR
  P["PATIENT"] ---|1| H{"HAS"} ---|N| E["ENCOUNTER"]
  E ---|1| R{"RECORDS"} ---|N| C["CHARGE"]
  E ---|1| B{"BILLED BY"} ---|0..1| I["INVOICE"]
  C ---|N| L{"APPEARS ON"} ---|1| I
  I ---|1| S{"SETTLED BY"} ---|N| T["RECEIPT"]
  pa(["patient_id PK"]) --- P
  pb(["display_label"]) --- P
  ea(["encounter_id PK"]) --- E
  eb(["setting / payer_route"]) --- E
  ca(["source_event_id unique"]) --- C
  cb(["price + tax snapshot"]) --- C
  ia(["invoice_no unique"]) --- I
  ib(["total_paise"]) --- I
  ta(["amount_paise"]) --- T
  classDef entity fill:#DDF7F3,stroke:#078E9B,stroke-width:2px,color:#173C55,font-weight:bold;
  classDef relation fill:#FFF1DE,stroke:#F4A03A,stroke-width:2px,color:#173C55,font-weight:bold;
  classDef attr fill:#FFFFFF,stroke:#80B9C5,stroke-width:1.5px,color:#314D5D;
  class P,E,C,I,T entity;
  class H,R,B,L,S relation;
  class pa,pb,ea,eb,ca,cb,ia,ib,ta attr;
